# Coolify / production. Points at the role/database created in the PostgreSQL instance already running on the VPS (ADR-006), reachable on the same Docker network or host.
DATABASE_URL=Host=<postgres-host>;Port=5432;Database=taxes_ua;Username=taxes_ua;Password=<secret>

# Google OAuth client for sign-in (ADR-005). Create it in Google Cloud -> APIs & Services ->
# Credentials, with the authorized redirect URI https://<domain>/api/auth/callback/google.
# Values live only in the environment and are never committed.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Emails allowed to sign in, comma-separated. Every other Google account is rejected with 403.
ALLOWED_EMAILS=

# The public domain, semicolon-separated. Pins both host filtering and the forwarded host the
# Google redirect URI is built from. "*" accepts any host and is only right for local runs.
ALLOWED_HOSTS=*
