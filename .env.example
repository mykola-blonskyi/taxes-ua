# Production variables, set in Coolify and never committed. docs/deploy.md is the runbook.
# Outside Development the api refuses to start while any of these is empty, and names the missing
# ones in its log. A local run needs none of them: docker-compose.local.yml switches to Development
# and supplies its own database and passkey domain.

# Npgsql connection string for the role and database docs/deploy.md step 2 creates in Coolify's
# shared-database instance (ADR-006), for example
# Host=3p9qjnulllqn3bcjqokir0wq;Port=5432;Database=taxes_ua;Username=taxes_ua_app;Password=<secret>
DATABASE_URL=

# Google OAuth client for sign-in (ADR-005), with the authorized redirect URI
# https://<domain>/api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Emails allowed to sign in, comma-separated. Every other Google account is rejected with 403.
ALLOWED_EMAILS=

# The public domain, semicolon-separated. Pins both host filtering and the forwarded host the
# Google redirect URI is built from, so a wildcard is refused too.
ALLOWED_HOSTS=

# The WebAuthn Relying Party ID for passkeys: the bare domain, no scheme and no port. A passkey is
# bound to the RP ID it was registered against, so this has to be the domain the owner visits.
PASSKEY_SERVER_DOMAIN=

# 32 random bytes, base64-encoded (`openssl rand -base64 32`), that encrypt the monobank personal
# API token (ADR-011). Unlike the variables above, the api starts without this one; the monobank
# settings section simply reports itself as not configured until it is set.
MONOBANK_TOKEN_ENCRYPTION_KEY=

# The bot token from @BotFather (docs/deploy.md, "Telegram bot"). Optional: the api starts without it,
# settings shows Telegram as unavailable and nothing polls. Never log it or put it in a URL you share.
TELEGRAM_BOT_TOKEN=

# The address a reminder links to, for example https://taxes.example.com. Optional: when empty the
# link is built from the first domain in ALLOWED_HOSTS, and a reminder goes without one when that is
# empty too. The api refuses to start when this is set but is not an absolute http or https URL.
APP_PUBLIC_URL=
