    "next": "16.3.6",
    "next-intl": "4.14.7",
    "next-themes": "0.4.6",
    "openapi-fetch": "0.17.0",
    "qrcode-generator": "2.0.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@serwist/cli": "9.5.12",
    "@serwist/next": "9.5.12",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "jsdom": "^30.1.1",
    "openapi-typescript": "7.13.0",
    "serwist": "9.5.12",
